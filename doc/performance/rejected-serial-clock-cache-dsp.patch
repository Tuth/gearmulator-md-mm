index 00000000..9be3ca48
--- /dev/null
+++ b/source/dsp56kTestRunner/serialClockDeadlineTest.cpp
@@ -0,0 +1,90 @@
+#include "dsp56kEmu/dsp.h"
+#include "dsp56kEmu/esxi.h"
+#include <functional>
+#include <iostream>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace {
+using namespace dsp56k;
+struct Port : Esxi {
+    bool tx = true, rx = true, mutated = false;
+    uint64_t now = 0;
+    std::vector<std::pair<uint64_t, bool>> events;
+    std::function<void()> onTransmit;
+    void execTX() override {
+        events.emplace_back(now, true);
+        if(onTransmit && !mutated) { mutated = true; onTransmit(); }
+    }
+    void execRX() override { events.emplace_back(now, false); }
+    TWord hasEnabledTransmitters() const override { return tx; }
+    TWord hasEnabledReceivers() const override { return rx; }
+};
+struct Fixture {
+    DefaultMemoryValidator validator;
+    Memory memory{validator, 0x1000};
+    Peripherals56303 x;
+    PeripheralsNop y;
+    DSP dsp{memory, &x, &y};
+    EsxiClock clock{x};
+    Port fine, base;
+    explicit Fixture(bool cached) {
+        clock.setDSP(&dsp);
+        clock.setClockSource(EsxiClock::ClockSource::Cycles);
+        clock.setCyclesPerSample(64);
+        clock.setEsaiDivider(&fine, 0);
+        clock.setEsaiDivider(&base, 1, 2);
+        clock.setEsaiFinePeriod(&fine, 19);
+        clock.setCachedDeadlineEnabled(cached);
+    }
+    void setTime(uint64_t instruction, uint64_t cycle) {
+        // Drive counters on a mutable fixture; no instructions execute here.
+        const_cast<uint64_t&>(dsp.getInstructionCounter()) = instruction;
+        const_cast<uint64_t&>(dsp.getCycles()) = cycle;
+        fine.now = base.now = cycle;
+    }
+    void mutate(unsigned step) {
+        if(step % 97 == 0) clock.setEsaiFinePeriod(&fine, step % 194 ? 23 : 0);
+        if(step % 131 == 0) clock.setCyclesPerSample(32 + step % 81);
+        if(step % 173 == 0) {
+            clock.setClockSource(step % 346 ? EsxiClock::ClockSource::Instructions : EsxiClock::ClockSource::Cycles);
+            clock.restartClock();
+            clock.setEsaiFinePeriod(&fine, 19);
+        }
+        if(step % 43 == 0) { fine.tx = !fine.tx; base.rx = !base.rx; }
+        if(step % 67 == 0) clock.setEsaiDivider(&base, step % 3, step % 4);
+        if(step % 89 == 0) clock.setEsaiCounter(&base, 0, 1);
+        if(step % 113 == 0 && step > 200) clock.shiftEsaiFineAnchor(&fine, -1);
+        if(step % 251 == 0) clock.setSpeedPercent(step % 502 ? 125 : 100);
+    }
+};
+void require(bool ok, const char* message) { if(!ok) throw std::runtime_error(message); }
+}
+int main() try {
+    Fixture original(false), cached(true);
+    uint64_t instructions = 0, cycles = 0;
+    uint32_t random = 0xabcde123;
+    for(unsigned step = 1; step <= 5000; ++step) {
+        random = random * 1664525u + 1013904223u;
+        instructions += (random >> 8) % 9;
+        cycles += step % 19 == 0 ? 193 : random % 17;
+        for(auto* f : {&original, &cached}) {
+            f->setTime(instructions, cycles);
+            f->mutate(step);
+            if(step == 777) f->fine.onTransmit = [f] {
+                f->clock.setCyclesPerSample(79);
+                f->clock.setEsaiDivider(&f->base, 2, 1);
+            };
+        }
+        require(original.clock.exec() == cached.clock.exec(), "instruction delay differs");
+        require(original.clock.getNextCycleDeadline() == cached.clock.getNextCycleDeadline(), "cycle deadline differs");
+        require(original.clock.getLastClock() == cached.clock.getLastClock(), "base phase differs");
+        require(original.fine.events == cached.fine.events && original.base.events == cached.base.events,
+            "serial TX/RX event timestamp or order differs");
+    }
+    require(original.fine.mutated && cached.fine.mutated, "reentrant mutation not exercised");
+    require(!original.fine.events.empty() && !original.base.events.empty(), "fixture generated no events");
+    std::cout << "Serial clock cached deadlines: PASS\n";
+    return 0;
+} catch(const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
